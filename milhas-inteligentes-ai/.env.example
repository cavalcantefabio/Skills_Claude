# Copie para .env.local e ajuste. Nunca faça commit de .env.local.
DATABASE_URL=postgres://milhas:milhas_dev@localhost:5432/milhas_inteligentes
# Banco usado pelos testes de integração (é apagado e recriado pelos testes).
TEST_DATABASE_URL=postgres://milhas:milhas_dev@localhost:5432/milhas_inteligentes_test
# Chave AES-256 em base64 (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Agente Inteligente (Etapa 2). Sem a chave, a página do agente explica como ativar.
# Use MILHAS_ANTHROPIC_API_KEY (em sessões do Claude Code, ANTHROPIC_API_KEY é reservado).
MILHAS_ANTHROPIC_API_KEY=
# Limite diário de mensagens ao agente por usuário (controle de custo).
AGENT_DAILY_MESSAGE_LIMIT=60
# Cadastro: por padrão só abre enquanto não existe nenhuma conta (uso pessoal).
# "true" mantém aberto (útil em desenvolvimento e nos testes ponta a ponta).
ALLOW_SIGNUP=false
# Conexões com o banco por instância (na Vercel, use 3).
DATABASE_POOL_MAX=10
# Atualizações do Radar por dia (cada uma custa ~US$ 0,35 em busca na web e tokens).
RADAR_DAILY_LIMIT=3
